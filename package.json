{
  "name": "bloodconnect",
  "version": "1.0.0",
  "description": "BloodConnect – Emergency Blood Donor Platform",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "frontend": "npm --prefix frontend-completion-checker-main run dev",
    "test:analytics": "node server/tests/testAnalytics.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "install:all": "npm --prefix server install && npm --prefix client install"
  },
  "keywords": [
    "blood-donation",
    "emergency",
    "hospital",
    "react",
    "mongodb",
    "nodejs",
    "socketio"
  ],
