# BloodConnect Server Configuration
PORT=5000

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas cluster connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/bloodconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bloodconnect?retryWrites=true&w=majority

NODE_ENV=development
